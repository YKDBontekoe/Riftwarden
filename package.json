{
  "name": "riftwarden",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @riftwarden/client dev",
    "build": "tsc --noEmit && pnpm --filter @riftwarden/client build",
    "preview": "pnpm --filter @riftwarden/client preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "server": "tsx apps/server/main.ts",
    "serve": "pnpm build && pnpm server"
  },
  "devDependencies": {
    "@babylonjs/core": "catalog:",
    "@riftwarden/client": "workspace:*",
    "@riftwarden/game": "workspace:*",
    "@riftwarden/rules": "workspace:*",
    "@riftwarden/server": "workspace:*",
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@types/ws": "catalog:",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "pg": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "^8.73.0",
    "vite": "catalog:",
    "vitest": "catalog:",
    "ws": "catalog:"
  }
}
