<!-- ClickHouse inside a 1 GB container: small caches, bounded merges, compact system logs. -->
<clickhouse>
    <max_server_memory_usage_to_ram_ratio>0.75</max_server_memory_usage_to_ram_ratio>
    <mark_cache_size>67108864</mark_cache_size>
    <uncompressed_cache_size>0</uncompressed_cache_size>
    <index_mark_cache_size>16777216</index_mark_cache_size>
    <primary_index_cache_size>16777216</primary_index_cache_size>
    <concurrent_threads_soft_limit_num>2</concurrent_threads_soft_limit_num>
    <background_schedule_pool_size>4</background_schedule_pool_size>
    <merge_tree>
        <merge_max_block_size>1024</merge_max_block_size>
        <max_bytes_to_merge_at_max_space_in_pool>1073741824</max_bytes_to_merge_at_max_space_in_pool>
    </merge_tree>
    <!-- ClickHouse's own logs: keep a week, not forever. -->
    <query_log replace="1"><database>system</database><table>query_log</table><ttl>event_date + INTERVAL 7 DAY DELETE</ttl><flush_interval_milliseconds>7500</flush_interval_milliseconds></query_log>
    <trace_log remove="1"/>
    <metric_log remove="1"/>
    <asynchronous_metric_log remove="1"/>
    <text_log remove="1"/>
    <part_log remove="1"/>
    <processors_profile_log remove="1"/>
    <logger><level>warning</level><console>1</console></logger>
</clickhouse>
